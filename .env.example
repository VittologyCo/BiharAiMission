# =================================================================
# Bihar AI Mission (biharaimission.org) - Environment Configuration
# =================================================================

# 1. Supabase (PostgreSQL, Realtime, Storage, Auth)
REACT_APP_SUPABASE_URL=https://your-project-ref.supabase.co
REACT_APP_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_publishable_key
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_publishable_key

# 2. Resend Email API (Transaction & Onboarding Emails)
RESEND_API_KEY=your_resend_api_key_here
REACT_APP_RESEND_FROM_EMAIL=Bihar AI Mission <onboarding@biharaimission.org>

# 3. Google OAuth Client ID (Sign in with Google)
REACT_APP_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# 4. Storage & File Upload Server (Optional - falls back to Google Drive / Supabase)
# REACT_APP_STORAGE_SERVER_URL=https://storage.biharaimission.org

# 5. Cloudflare Worker / Google Drive Service Account (Worker Secrets)
# Set via: npx wrangler secret put GOOGLE_SERVICE_ACCOUNT_EMAIL
# Set via: npx wrangler secret put GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY
# GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id
